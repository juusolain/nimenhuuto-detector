# Create a bot with @BotFather and put its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=replace_me

# Detection settings
TARGET_PHRASES=nimenhuuto,nimen huuto
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fi
MATCH_THRESHOLD=0.86
MIN_LOG_PROBABILITY=-0.8
WINDOW_SECONDS=6
STRIDE_SECONDS=2
ALERT_COOLDOWN_SECONDS=600
MIN_AUDIO_DBFS=-50

# Leave empty for the system default input device. A device index or name works.
AUDIO_DEVICE=
LOG_LEVEL=INFO
